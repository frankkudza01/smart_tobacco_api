# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Include 10.0.2.2 for Android Emulator → host PC. For a physical phone, add your PC LAN IP (e.g. 192.168.1.10).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Database
DATABASE_URL=postgres://tobacco_user:tobacco_pass@db:5432/tobacco_db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Local settings: false = in-memory cache (no Redis required for login/throttles).
# Set true when Redis is running and you want django_redis for default cache (e.g. multi-worker).
USE_REDIS_CACHE=false

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Object Storage (MinIO / S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=tobacco-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_FILE_OVERWRITE=False
AWS_DEFAULT_ACL=private

# Blockchain
# Mock (no node): BLOCKCHAIN_ENABLED=False — Celery uses MockBlockchainGateway.
# Hardhat local: run `cd hardhat && npm run node`, then `npm run deploy:local` and paste values below.
BLOCKCHAIN_ENABLED=False
BLOCKCHAIN_PROVIDER_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# Hardhat account #0 (dev only): 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=

# AI / LLM
AI_ENABLED=False
# openai | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder
# Set when AI_PROVIDER=gemini
GEMINI_API_KEY=
# For Gemini use e.g. gemini-2.0-flash or gemini-1.5-flash
AI_MODEL_NAME=gpt-4o-mini
# Retries per model on 429/5xx (high demand). Default 6.
# AI_GEMINI_MAX_HTTP_RETRIES=6
# After primary exhausts retries, try this model on overload (503). Set empty to disable.
# AI_GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Optional override for image-based grading (OpenAI vision). Leave empty to use AI_MODEL_NAME.
AI_VISION_MODEL_NAME=
AI_MAX_TOKENS=2048
# If True, the in-app assistant always returns the safe fallback message (no LLM), even when AI_ENABLED=True.
# Use False for normal chat; keep True only for outages, Python 3.14+ issues, or deliberate read-only mode.
AI_FORCE_FALLBACK=False

# AgroMonitoring / tobacco geospatial monitoring
# AgroMonitoring (satellite NDVI / soil — separate from OpenWeatherMap). Key from https://agromonitoring.com/
AGROMONITORING_API_KEY=
# Use https (recommended). Must match Agro API path /agro/1.0/
AGROMONITORING_BASE_URL=https://api.agromonitoring.com/agro/1.0
AGROMONITORING_TIMEOUT_SECONDS=30
AGROMONITORING_MAX_RETRIES=3

# Meta WhatsApp Cloud API for stress alerts
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
META_WHATSAPP_TIMEOUT_SECONDS=20
META_WHATSAPP_MAX_RETRIES=3

# Tobacco satellite monitoring tuning
SATELLITE_POLL_CRON=0 6 * * *
NDVI_STRESS_DROP_THRESHOLD=10.0
SOIL_MOISTURE_STRESS_THRESHOLD=0.18
SOIL_MOISTURE_DROP_THRESHOLD_PCT=20.0
DEFAULT_ALERT_LANGUAGE=en
DEFAULT_COUNTRY_CODE=ZW
TOBACCO_DEFAULT_CROP=tobacco
TOBACCO_AUTO_CREATE_POLYGON_FROM_GEOFENCE=True
TOBACCO_SUPPORTED_PROVINCES=Mashonaland Central,Mashonaland West,Mashonaland East,Manicaland
TOBACCO_YIELD_PROXY_COEFFICIENT=0.25
TOBACCO_PLANTING_NDVI_THRESHOLD=0.25

# OpenWeatherMap — farmer forecasts (Zimbabwe). Never commit real keys; use https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
# Optional: same label as in OpenWeatherMap “Key name” column (e.g. tobacco).
OPENWEATHERMAP_KEY_NAME=
OPENWEATHERMAP_TIMEOUT_SECONDS=15

# Sentry
SENTRY_DSN=

# Field encryption (Fernet key: url-safe base64 32-byte, or leave empty to skip encrypt in dev)
PII_ENCRYPTION_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Twilio / WhatsApp
# Provider: auto | twilio | waapi | mock
# auto = WaAPI if WAAPI_TOKEN+WAAPI_INSTANCE_ID set, else Twilio if SID+token, else mock (dev).
WHATSAPP_PROVIDER=auto
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_PATH=/api/v1/whatsapp/webhook/
TWILIO_STATUS_CALLBACK_PATH=/api/v1/whatsapp/status/
# WaAPI (https://waapi.app) — same webhook URL root as Twilio: POST {PUBLIC_URL}/whatsapp/webhook/
# Instance display name in WaAPI (e.g. TOBACCO) is separate from WAAPI_TOKEN.
WAAPI_BASE_URL=https://waapi.app/api/v1
WAAPI_INSTANCE_ID=
WAAPI_TOKEN=
# Optional shared secret; inbound requests must send header X-WAAPI-WEBHOOK-SECRET with this value.
WAAPI_WEBHOOK_SECRET=

# WhatsApp conversation TTL (minutes)
WHATSAPP_CONVERSATION_TTL_MINUTES=30

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CODE_LENGTH=6
ENABLE_DEV_OTP_LOGGING=True

# Superuser seed
DJANGO_SUPERUSER_EMAIL=admin@tobacco.zw
DJANGO_SUPERUSER_PASSWORD=admin123456
